<?xml version="1.0" encoding="utf-8"?>
<!-- Статические шорткаты лаунчера; meta-data android.app.shortcuts размещён на каждом activity-alias иконки -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutId="add_item"
        android:shortcutShortLabel="@string/add_item">
        <intent
            android:action="com.dayscounter.action.CREATE_ITEM"
            android:targetClass="com.dayscounter.MainActivity"
            android:targetPackage="com.dayscounter" />
    </shortcut>
</shortcuts>
